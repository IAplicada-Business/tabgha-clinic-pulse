# Env / secrets
.env
.env.*
# Exceção: .env guarda só a URL e a chave publicável do Supabase, que já
# são públicas por definição (vão no bundle do navegador). Versioná-las
# impede que um build sem as variáveis da Lovable derrube o app inteiro.
!.env

# Supabase CLI local state
supabase/.temp/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
